# Application
NODE_ENV=development
PORT=3001

# Database
# connection_limit: pin the Prisma pool size explicitly (production default: 10; see docker-compose.prod.yml)
DATABASE_URL="postgresql://user:password@localhost:5432/workout_tracker?schema=public&connection_limit=10"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# CORS (optional)
CORS_ORIGIN=http://localhost:3000

# Breached-password screening (optional)
# Registration and password changes are screened against Have I Been Pwned's
# k-anonymity range API. If it is unreachable the password is allowed through
# (fail open) and a warning is logged. Defaults: public API, 3000ms timeout.
# PWNED_PASSWORDS_API_URL=https://api.pwnedpasswords.com/range
# PWNED_PASSWORDS_TIMEOUT_MS=3000
