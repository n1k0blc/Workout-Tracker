# ====================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ====================================================================
# This file is an EXAMPLE for local development. 
# Copy this to .env.local and customize for your needs.
#
# SECURITY: .env.local is gitignored and will NEVER be committed
# ====================================================================

# Development mode (REQUIRED for MOCK_DATE to work)
NODE_ENV=development

# Database connection
DATABASE_URL="postgresql://localhost:5432/workout_tracker"

# ====================================================================
# MOCK DATE FOR TESTING
# ====================================================================
# Allows you to simulate different dates when creating workouts.
# Useful for testing analytics with data from multiple days.
#
# FORMAT: YYYY-MM-DD
# EXAMPLE: MOCK_DATE=2026-04-05
#
# TO CHANGE DATE:
# 1. Edit this line to desired date
# 2. Restart backend (npm run start:dev)
# 3. Create new workout -> will use mocked date
#
# TO DISABLE:
# - Comment out the line below or delete it
# - Real date will be used instead
#
# SECURITY:
# - Only works when NODE_ENV=development
# - Console warning appears when active
# - Production ALWAYS uses real date
# ====================================================================

# Uncomment and set to desired date:
# MOCK_DATE=2026-04-05

# ====================================================================
# TESTING WORKFLOW EXAMPLE
# ====================================================================
# Day 1: MOCK_DATE=2026-04-01 -> Create workout -> Complete
# Day 2: MOCK_DATE=2026-04-03 -> Create workout -> Complete  
# Day 3: MOCK_DATE=2026-04-05 -> Create workout -> Complete
# Day 4: MOCK_DATE=2026-04-08 -> Create workout -> Complete
#
# Now analytics page shows data across multiple days!
# ====================================================================
