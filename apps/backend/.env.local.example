# ====================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ====================================================================
# This file is an EXAMPLE for local development. 
# Copy this to .env.local and customize for your needs.
#
# SECURITY: .env.local is gitignored and will NEVER be committed
# ====================================================================

# Development mode (REQUIRED for MOCK_DATE to work)
NODE_ENV=development

# Database connection
DATABASE_URL="postgresql://localhost:5432/workout_tracker"

# ====================================================================
# MOCK DATE FOR TESTING
# ====================================================================
# Allows you to simulate different dates when creating workouts.
# Useful for testing analytics with data from multiple days.
#
# FORMAT: YYYY-MM-DD
# EXAMPLE: MOCK_DATE=2026-04-05
#
# TO CHANGE DATE:
# 1. Edit this line to desired date
# 2. Restart backend (npm run start:dev)
# 3. Create new workout -> will use mocked date
#
# TO DISABLE:
# - Comment out the line below or delete it
# - Real date will be used instead
#
# SECURITY:
# - Only works when NODE_ENV=development
# - Console warning appears when active
# - Production ALWAYS uses real date
# ====================================================================

# Uncomment and set to desired date:
# MOCK_DATE=2026-04-05

# ====================================================================
# LOCAL NETWORK / iPHONE TESTING (Mac + iPhone on same WiFi)
# ====================================================================
# The backend CORS is now dev-friendly by default:
# - Always allows http://localhost:3000 and http://127.0.0.1:3000
# - Always allows private network ranges (192.168.*, 10.*, 172.16-31.*)
# - You can still explicitly add origins via CORS_ORIGIN if needed.
#
# Recommended workflow:
#
# 1. Find your Mac's local IP address:
#    ipconfig getifaddr en0     # (WiFi interface, may be en1 etc.)
#
# 2. Start backend (no special CORS_ORIGIN needed for most cases):
#    npm run start:dev
#    (It binds to 0.0.0.0 so other devices can reach it.)
#
#    If you want to be explicit or test a specific device:
#    CORS_ORIGIN="http://192.168.1.42:3000,http://another-device:3000" npm run start:dev
#
# 3. Start frontend pointing to the Mac's IP (important!):
#    NEXT_PUBLIC_API_URL=http://192.168.1.42:3001/api npm run dev
#
# 4. On your iPhone:
#    - Same WiFi network (disable any VPN)
#    - Open Safari and go to: http://192.168.1.42:3000
#    - The frontend will call the backend using the IP you set in NEXT_PUBLIC_API_URL
#
# Common issues:
# - Mac Firewall blocking Node: System Settings → Network → Firewall → allow "node"
# - Wrong IP in NEXT_PUBLIC_API_URL (must point to the Mac running the backend)
# - Accessing the frontend via localhost on Mac while backend was started with restrictive CORS (now mitigated)
#
# For testing from the internet (others can try your app): use ngrok / Cloudflare Tunnel.
# ====================================================================

# ====================================================================
# TESTING WORKFLOW EXAMPLE
# ====================================================================
# Day 1: MOCK_DATE=2026-04-01 -> Create workout -> Complete
# Day 2: MOCK_DATE=2026-04-03 -> Create workout -> Complete  
# Day 3: MOCK_DATE=2026-04-05 -> Create workout -> Complete
# Day 4: MOCK_DATE=2026-04-08 -> Create workout -> Complete
#
# Now analytics page shows data across multiple days!
# ====================================================================
