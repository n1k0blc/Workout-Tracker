generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  dateOfBirth   DateTime?
  firstName     String?
  height        Int?
  lastName      String?
  weight        Float?
  exercises     Exercise[]
  homeGyms      HomeGym[]
  workouts      Workout[]
  workoutCycles WorkoutCycle[]
  refreshTokens RefreshToken[]
}

// PR1 auth overhaul: DB-backed rotating refresh tokens (httpOnly cookie).
// Only the SHA-256 hash of the opaque token is stored, never the raw value.
// `replacedByTokenHash` chains rotations so a replayed, already-rotated token
// is detectable as theft (reuse detection) even without walking the whole chain.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HomeGym {
  id                 String       @id @default(uuid())
  name               String
  userId             String
  createdAt          DateTime     @default(now())
  deletedAt          DateTime?
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts           Workout[]
  plannedWorkoutDays WorkoutDay[] @relation("PlannedHomeGym")
}

model WorkoutCycle {
  id          String       @id @default(uuid())
  name        String
  duration    Int
  startDate   DateTime
  status      CycleStatus  @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  userId      String
  workouts    Workout[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDays WorkoutDay[]
}

model WorkoutDay {
  id               String       @id @default(uuid())
  weekday          Int
  order            Int
  name             String
  cycleId          String
  plannedHomeGymId String?
  workouts         Workout[]
  cycle            WorkoutCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  plannedHomeGym   HomeGym?     @relation("PlannedHomeGym", fields: [plannedHomeGymId], references: [id])

  @@unique([cycleId, order])
  // The weekday decides which workout is recommended, so two days in one cycle may not share
  // one. Days in *different* cycles reuse weekdays freely.
  @@unique([cycleId, weekday])
}

// Unified data model (PR2): one Workout entity discriminated by `kind`,
// replacing the three former parallel hierarchies (WorkoutBlueprint/BlueprintExercise/BlueprintSet,
// WorkoutTemplate/WorkoutTemplateExercise/WorkoutTemplateSet, Workout/ExerciseLog/SetLog).
// Kind-specific fields are nullable; a row's mere existence implies "saved/complete" —
// there is no server-side draft/in-progress state (logging happens fully client-side).
model Workout {
  id     String      @id @default(uuid())
  kind   WorkoutKind
  userId String? // nullable: system templates (kind=TEMPLATE, isCustom=false) have no owner
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // kind=WORKOUT (performed)
  date          DateTime?
  // The calendar day the workout happened on in the user's local timezone, `YYYY-MM-DD`.
  // Deliberately a string, not a date column: a date column comes back through the ORM as a
  // timestamp at UTC midnight, which is the instant-versus-calendar-day confusion this field
  // exists to remove. Nullable only because kind=TEMPLATE/BLUEPRINT rows share this table --
  // for kind=WORKOUT it is required, enforced by a CHECK constraint in the migration SQL and
  // by the DTO at the API boundary.
  localDate     String?
  totalDuration Int?
  isFreeWorkout Boolean?
  cycleId       String?
  cycle         WorkoutCycle? @relation(fields: [cycleId], references: [id])

  // kind=WORKOUT (cycle day this instance belongs to) or kind=BLUEPRINT (the day this is the plan for; 1:1, enforced via partial unique index in migration SQL)
  workoutDayId String?
  workoutDay   WorkoutDay? @relation(fields: [workoutDayId], references: [id])

  // kind=WORKOUT: which template (if any) this was started from — drives the "overwrite template" auto-detect UX
  originTemplateId String?
  originTemplate   Workout?  @relation("WorkoutOrigin", fields: [originTemplateId], references: [id], onDelete: SetNull)
  startedFrom      Workout[] @relation("WorkoutOrigin")

  // kind=WORKOUT or kind=TEMPLATE: which gym this was performed at / is recommended for
  homeGymId String?
  homeGym   HomeGym? @relation(fields: [homeGymId], references: [id])

  // kind=TEMPLATE (name unique per userId, partial unique index in migration SQL --
  // NULL userId rows, i.e. system templates, are exempt from that uniqueness)
  name     String?
  isCustom Boolean?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  exercises WorkoutExercise[]

  @@index([userId, kind])
}

model WorkoutExercise {
  id         String       @id @default(uuid())
  order      Int
  workoutId  String
  exerciseId String
  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
  sets       WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id                String    @id @default(uuid())
  order             Int
  workoutExerciseId String
  setType           SetType   @default(WORKING)
  reps              Int
  weight            Float
  rir               Int?
  rest              Int? // seconds rested after completing this set; app defaults to 90 when absent
  completedAt       DateTime? // meaningful only for kind=WORKOUT sets

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, order])
}

model Exercise {
  id                String            @id @default(uuid())
  csvId             Int?              @unique
  name              String
  equipment         Equipment
  isCustom          Boolean           @default(false)
  userId            String?
  isDoubleWeight    Boolean           @default(false)
  isUnilateral      Boolean           @default(false)
  deletedAt         DateTime?
  // Muscle group distribution in percentages (must sum to 100) — single source of truth;
  // "primary muscle" is derived (max-percent column), not stored.
  abdomenPercent    Int               @default(0)
  latissimusPercent Int               @default(0)
  trapeziusPercent  Int               @default(0)
  lowerBackPercent  Int               @default(0)
  hamstringsPercent Int               @default(0)
  glutesPercent     Int               @default(0)
  shouldersPercent  Int               @default(0)
  bicepsPercent     Int               @default(0)
  chestPercent      Int               @default(0)
  quadricepsPercent Int               @default(0)
  calvesPercent     Int               @default(0)
  tricepsPercent    Int               @default(0)
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises  WorkoutExercise[]
}

enum Equipment {
  CABLE
  MACHINE
  DUMBBELL
  BARBELL
  BODYWEIGHT
  SMITH_MACHINE
  EZ_BAR
}

enum WorkoutKind {
  BLUEPRINT
  TEMPLATE
  WORKOUT
}

enum SetType {
  WARMUP
  WORKING
}

enum CycleStatus {
  ACTIVE
  COMPLETED
}
